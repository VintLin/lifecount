---
import LifeCountLayout from "@/layouts/LifeCountLayout.astro";
import { lifeCountConfig } from "@/data/lifecount";
import { lifeCountMessages } from "@/i18n/lifecount";
import { ButtonRoot } from "@starwind-ui/astro/button";
import { DialogPopup, DialogRoot } from "@starwind-ui/astro/dialog";

const messages = lifeCountMessages["zh-CN"];
const canonical = new URL(import.meta.env.BASE_URL, Astro.site).toString();
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: messages.documentTitle,
  url: canonical,
  description: messages.description,
  inLanguage: "zh-CN"
};
---

<LifeCountLayout
  title={messages.documentTitle}
  description={messages.description}
  canonical={canonical}
  lang="zh-CN"
  schema={schema}
>
  <section class="lifecount-page" data-lifecount>
    <header class="lifecount-header slide-enter">
      <div class="lifecount-header-meta">
        <span class="lifecount-brand-title" data-lifecount-title>人生计数</span>
        <div class="lifecount-header-actions">
          <a
            class="lifecount-header-button"
            href="https://github.com/VintLin/lifecount"
            target="_blank"
            rel="noreferrer"
            data-lifecount-github
            aria-label="在 GitHub 查看 LifeCount"
            title="在 GitHub 查看 LifeCount"
          >
            <svg viewBox="0 -0.5 25 25" fill="currentColor" aria-hidden="true">
              <path d="m12.301 0h.093c2.242 0 4.34.613 6.137 1.68l-.055-.031c1.871 1.094 3.386 2.609 4.449 4.422l.031.058c1.04 1.769 1.654 3.896 1.654 6.166 0 5.406-3.483 10-8.327 11.658l-.087.026c-.063.02-.135.031-.209.031-.162 0-.312-.054-.433-.144l.002.001c-.128-.115-.208-.281-.208-.466 0-.005 0-.01 0-.014v.001q0-.048.008-1.226t.008-2.154c.007-.075.011-.161.011-.249 0-.792-.323-1.508-.844-2.025.618-.061 1.176-.163 1.718-.305l-.076.017c.573-.16 1.073-.373 1.537-.642l-.031.017c.508-.28.938-.636 1.292-1.058l.006-.007c.372-.476.663-1.036.84-1.645l.009-.035c.209-.683.329-1.468.329-2.281 0-.045 0-.091-.001-.136v.007c0-.022.001-.047.001-.072 0-1.248-.482-2.383-1.269-3.23l.003.003c.168-.44.265-.948.265-1.479 0-.649-.145-1.263-.404-1.814l.011.026c-.115-.022-.246-.035-.381-.035-.334 0-.649.078-.929.216l.012-.005c-.568.21-1.054.448-1.512.726l.038-.022-.609.384c-.922-.264-1.981-.416-3.075-.416s-2.153.152-3.157.436l.081-.02q-.256-.176-.681-.433c-.373-.214-.814-.421-1.272-.595l-.066-.022c-.293-.154-.64-.244-1.009-.244-.124 0-.246.01-.364.03l.013-.002c-.248.524-.393 1.139-.393 1.788 0 .531.097 1.04.275 1.509l-.01-.029c-.785.844-1.266 1.979-1.266 3.227 0 .025 0 .051.001.076v-.004c-.001.039-.001.084-.001.13 0 .809.12 1.591.344 2.327l-.015-.057c.189.643.476 1.202.85 1.693l-.009-.013c.354.435.782.793 1.267 1.062l.022.011c.432.252.933.465 1.46.614l.046.011c.466.125 1.024.227 1.595.284l.046.004c-.431.428-.718 1-.784 1.638l-.001.012c-.207.101-.448.183-.699.236l-.021.004c-.256.051-.549.08-.85.08-.022 0-.044 0-.066 0h.003c-.394-.008-.756-.136-1.055-.348l.006.004c-.371-.259-.671-.595-.881-.986l-.007-.015c-.198-.336-.459-.614-.768-.827l-.009-.006c-.225-.169-.49-.301-.776-.38l-.016-.004-.32-.048c-.023-.002-.05-.003-.077-.003-.14 0-.273.028-.394.077l.007-.003q-.128.072-.08.184c.039.086.087.16.145.225l-.001-.001c.061.072.13.135.205.19l.003.002.112.08c.283.148.516.354.693.603l.004.006c.191.237.359.505.494.792l.01.024.16.368c.135.402.38.738.7.981l.005.004c.3.234.662.402 1.057.478l.016.002c.33.064.714.104 1.106.112h.007c.045.002.097.002.15.002.261 0 .517-.021.767-.062l-.027.004.368-.064q0 .609.008 1.418t.008.873v.014c0 .185-.08.351-.208.466h-.001c-.119.089-.268.143-.431.143-.075 0-.147-.011-.214-.032l.005.001c-4.929-1.689-8.409-6.283-8.409-11.69 0-2.268.612-4.393 1.681-6.219l-.032.058c1.094-1.871 2.609-3.386 4.422-4.449l.058-.031c1.739-1.034 3.835-1.645 6.073-1.645h.098-.005zm-7.64 17.666q.048-.112-.112-.192-.16-.048-.208.032-.048.112.112.192.144.096.208-.032zm.497.545q.112-.08-.032-.256-.16-.144-.256-.048-.112.08.032.256.159.157.256.047zm.48.72q.144-.112 0-.304-.128-.208-.272-.096-.144.08 0 .288t.272.112zm.672.673q.128-.128-.064-.304-.192-.192-.32-.048-.144.128.064.304.192.192.32.044zm.913.4q.048-.176-.208-.256-.24-.064-.304.112t.208.24q.24.097.304-.096zm1.009.08q0-.208-.272-.176-.256 0-.256.176 0 .208.272.176.256.001.256-.175zm.929-.16q-.032-.176-.288-.144-.256.048-.224.24t.288.128.225-.224z"></path>
            </svg>
          </a>
          <div class="lifecount-header-button lifecount-language-button lifecount-language-select lifecount-custom-select" data-lifecount-custom-select>
            <button class="lifecount-select-trigger" type="button" data-lifecount-select-trigger aria-haspopup="listbox" aria-expanded="false">
              <span class="lifecount-language-label" data-lifecount-language-label>中文</span>
              <svg class="lifecount-language-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>
            <div class="lifecount-select-menu" data-lifecount-select-menu role="listbox" hidden></div>
            <select class="lifecount-native-select" data-lifecount-language aria-label="语言" tabindex="-1" aria-hidden="true">
              <option value="zh-CN">中文</option>
              <option value="en">English</option>
            </select>
          </div>
          <div class="lifecount-header-button lifecount-unit-select lifecount-custom-select" data-lifecount-custom-select>
            <button class="lifecount-select-trigger" type="button" data-lifecount-select-trigger aria-haspopup="listbox" aria-expanded="false">
              <span class="lifecount-unit-label" data-lifecount-unit-label>周</span>
              <svg class="lifecount-unit-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>
            <div class="lifecount-select-menu" data-lifecount-select-menu role="listbox" hidden></div>
            <select class="lifecount-native-select" data-lifecount-unit-select aria-label="选择时间单位" tabindex="-1" aria-hidden="true">
              <option value="day">日</option>
              <option value="week" selected>周</option>
              <option value="month">月</option>
              <option value="year">年</option>
            </select>
          </div>
          <ButtonRoot
            class="lifecount-header-button lifecount-settings-button"
            type="button"
            data-lifecount-settings
            data-sw-dialog-trigger
            data-sw-dialog-target-id="lifecount-settings-surface"
            aria-label="人生计数设置"
            title="人生计数设置"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0-0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </ButtonRoot>

        </div>
      </div>
    </header>

    <div class="lifecount-toolbar slide-enter">
      <div class="lifecount-summary" aria-live="polite">
        <strong data-lifecount-age></strong>
        <span data-lifecount-summary></span>
      </div>
    </div>

    <div class="lifecount-panel slide-enter" data-lifecount-map-wrap>
      <div class="lifecount-map-shell">
        <div class="lifecount-map-stage">
          <div class="lifecount-map" data-lifecount-map></div>
          <div class="lifecount-map-axis-x" data-lifecount-axis-x aria-hidden="true"></div>
          <div class="lifecount-map-axis-y" data-lifecount-axis-y aria-hidden="true"></div>
          <div class="lifecount-annotations" data-lifecount-annotations aria-label="关键人生节点"></div>
          <div class="lifecount-annotation-popover" data-lifecount-annotation-popover role="dialog" aria-live="polite" hidden></div>
          <div class="lifecount-cell-popover" data-lifecount-cell-popover role="dialog" aria-live="polite" hidden></div>
        </div>
      </div>
      <div class="lifecount-legend" data-lifecount-legend role="list" aria-label="图例"></div>
    </div>

    <DialogRoot id="lifecount-settings-surface" data-lifecount-settings-surface>
      <DialogPopup class="lifecount-settings-dialog" data-lifecount-settings-dialog aria-labelledby="lifecount-settings-title">
        <div class="lifecount-settings-header">
          <div class="lifecount-settings-tabs" role="tablist" aria-label="人生视图">
            <ButtonRoot type="button" data-lifecount-settings-tab="me" role="tab" aria-selected="true">
              <span data-lifecount-settings-tab-label="me">我</span>
            </ButtonRoot>
            <ButtonRoot type="button" data-lifecount-settings-tab="biography" role="tab" aria-selected="false">
              <span data-lifecount-settings-tab-label="biography">名人履历</span>
            </ButtonRoot>
          </div>
          <ButtonRoot class="lifecount-toolbar-button" type="button" data-lifecount-settings-cancel data-sw-dialog-close aria-label="关闭设置" title="关闭设置">
            <img class="lifecount-settings-close-icon" src="/lifecount/icons/close.svg" alt="" aria-hidden="true" />
          </ButtonRoot>
        </div>
        <div class="lifecount-settings-body">
          <section data-lifecount-settings-panel="me" role="tabpanel">
            <div>
              <h2 id="lifecount-settings-title" class="lifecount-visually-hidden" data-lifecount-settings-title>人生计数设置</h2>
              <div class="lifecount-settings-grid lifecount-settings-grid-secondary">
                <label class="lifecount-settings-field">
                  <span data-lifecount-country-field-label>国家</span>
                  <div class="lifecount-select-shell lifecount-country-select lifecount-custom-select" data-lifecount-custom-select>
                    <button class="lifecount-select-trigger" type="button" data-lifecount-select-trigger aria-haspopup="listbox" aria-expanded="false">
                      <span data-lifecount-country-value></span>
                      <svg class="lifecount-select-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                    </button>
                    <div class="lifecount-select-menu" data-lifecount-select-menu role="listbox" hidden></div>
                    <select class="lifecount-native-select" data-lifecount-country aria-label="选择国家" tabindex="-1" aria-hidden="true"></select>
                  </div>
                </label>
                <label class="lifecount-settings-field">
                  <span data-lifecount-preset-field-label>模板</span>
                  <div class="lifecount-select-shell lifecount-preset-select lifecount-custom-select" data-lifecount-custom-select>
                    <button class="lifecount-select-trigger" type="button" data-lifecount-select-trigger aria-haspopup="listbox" aria-expanded="false">
                      <span data-lifecount-preset-value></span>
                      <svg class="lifecount-select-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                    </button>
                    <div class="lifecount-select-menu" data-lifecount-select-menu role="listbox" hidden></div>
                    <select class="lifecount-native-select" data-lifecount-preset aria-label="选择典型人生案例" tabindex="-1" aria-hidden="true"></select>
                  </div>
                </label>
              </div>
              <div class="lifecount-settings-grid lifecount-settings-grid-primary">
                <label class="lifecount-settings-field">
                  <span data-lifecount-birthday-label>出生日期</span>
                  <input type="date" data-lifecount-birthday required />
                </label>
                <label class="lifecount-settings-field">
                  <span data-lifecount-display-age-label>最高年龄</span>
                  <input type="number" data-lifecount-display-age min="1" max="120" step="1" required />
                </label>
              </div>
              <div class="lifecount-settings-icon-actions">
                <ButtonRoot class="lifecount-toolbar-button lifecount-annotation-toggle" type="button" data-lifecount-stage-annotations-toggle aria-pressed="false" aria-label="显示或隐藏典型人生阶段和事件" title="典型人生阶段和事件">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 12h-5"></path><path d="M15 8h-5"></path><path d="M19 17V5a2 2 0 0 0-2-2H4"></path><path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3"></path></svg>
                  <span class="lifecount-visually-hidden" data-lifecount-stage-label>阶段</span>
                </ButtonRoot>
                <ButtonRoot class="lifecount-toolbar-button lifecount-annotation-toggle" type="button" data-lifecount-celebrity-annotations-toggle aria-pressed="false" aria-label="显示或隐藏名人去世时间" title="名人去世时间">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 10h2"></path><path d="M19 21V10a7 7 0 0 0-14 0v11"></path><path d="M2 21h20"></path><path d="M9 14h6"></path></svg>
                  <span class="lifecount-visually-hidden" data-lifecount-celebrity-label>名人</span>
                </ButtonRoot>
              </div>
              <div class="lifecount-stage-list" data-lifecount-stage-list></div>
            </div>
          </section>
          <section data-lifecount-settings-panel="biography" role="tabpanel" hidden>
            <div class="lifecount-settings-field lifecount-biography-field">
              <span data-lifecount-biography-field-label>名人</span>
              <div class="lifecount-biography-picker lifecount-custom-select" data-lifecount-biography-picker data-lifecount-custom-select>
                <button class="lifecount-select-trigger" type="button" data-lifecount-select-trigger aria-haspopup="listbox" aria-expanded="false">
                  <span data-lifecount-biography-value></span>
                  <svg class="lifecount-biography-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                </button>
                <div class="lifecount-select-menu" data-lifecount-select-menu role="listbox" hidden></div>
                <select class="lifecount-native-select" data-lifecount-biography aria-label="选择名人" tabindex="-1" aria-hidden="true"></select>
              </div>
            </div>
            <div class="lifecount-settings-grid lifecount-settings-grid-primary lifecount-biography-meta">
              <label class="lifecount-settings-field">
                <span data-lifecount-biography-birthday-label>出生日期</span>
                <input type="date" data-lifecount-biography-birthday disabled />
              </label>
              <label class="lifecount-settings-field">
                <span data-lifecount-biography-display-age-label>最高年龄</span>
                <input type="number" data-lifecount-biography-display-age min="1" max="120" step="1" required />
              </label>
            </div>
            <div class="lifecount-stage-list" data-lifecount-biography-stage-list></div>
          </section>
        </div>
      </DialogPopup>
    </DialogRoot>

  </section>

  <script type="application/json" id="lifecount-config" set:html={JSON.stringify(lifeCountConfig)}></script>
  <script>
    import { initLifeCount } from "@/scripts/lifecount";

    initLifeCount();
  </script>
</LifeCountLayout>

<style is:global>
  .lifecount-page {
    --life-blue: #5c6ef2;
    --life-cyan: #1ca8b8;
    --life-green: #4b9b68;
    --life-orange: #d98332;
    --life-pink: #d45b93;
    --life-purple: #936bd1;
    --life-red: #c85a5a;
    --life-sand: #b88a55;
    --lifecount-content-max-width: 42rem;
    --lifecount-control-radius: 0.75rem;
    --lifecount-control-font-size: 0.875rem;
    --lifecount-control-font-weight: 400;
    --lifecount-control-line-height: 1.25rem;
    width: min(100%, var(--lifecount-content-max-width));
    margin: 0 auto;
    padding-inline: 0;
  }

  .lifecount-header {
    position: relative;
    z-index: 20;
    width: 100%;
    margin: 0 auto 2rem;
  }

  .lifecount-header-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .lifecount-header-meta .page-kicker {
    margin: 0;
  }

  .lifecount-header-actions {
    display: inline-flex;
    flex: none;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .lifecount-header-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: var(--lifecount-control-radius);
    background: var(--header-control-bg);
    color: var(--header-control-fg);
    opacity: 1;
    cursor: pointer;
    text-decoration: none;
    transition:
      color 180ms ease,
      background 180ms ease;
  }

  .lifecount-header-button:hover,
  .lifecount-header-button:focus-visible {
    background: var(--header-control-hover-bg);
    color: var(--header-control-hover-fg);
    opacity: 1;
  }

  .lifecount-header-button:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--header-control-fg) 50%, transparent);
    outline-offset: 2px;
  }

  .lifecount-header-button svg {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
  }

  .lifecount-custom-select {
    position: relative;
  }

  .lifecount-select-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-width: 0;
    gap: 0.25rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .lifecount-select-trigger:focus-visible {
    outline: 2px solid color-mix(in srgb, currentColor 45%, transparent);
    outline-offset: -2px;
  }

  .lifecount-select-trigger:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .lifecount-native-select {
    display: none !important;
  }

  .lifecount-select-menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    z-index: 30;
    display: grid;
    min-width: 100%;
    width: max-content;
    max-width: min(18rem, calc(100vw - 2rem));
    gap: 0.15rem;
    padding: 0.3rem;
    border: 1px solid color-mix(in srgb, var(--fg-strong) 14%, transparent);
    border-radius: var(--lifecount-control-radius);
    background: var(--bg);
    color: var(--fg-strong);
    box-shadow: 0 0.8rem 2rem color-mix(in srgb, var(--fg-strong) 16%, transparent);
  }

  .lifecount-select-menu[hidden] {
    display: none;
  }

  .lifecount-select-option {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1rem;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
    min-height: 2rem;
    padding: 0.35rem 0.55rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.25rem;
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
  }

  .lifecount-select-option:hover,
  .lifecount-select-option:focus-visible {
    background: var(--header-control-hover-bg);
    outline: 0;
  }

  .lifecount-select-option[aria-selected="true"] {
    font-weight: 500;
  }

  .lifecount-select-option-check {
    width: 1rem;
    color: currentColor;
    text-align: center;
    grid-column: 2;
    grid-row: 1;
  }

  .lifecount-select-option:not([aria-selected="true"]) .lifecount-select-option-check {
    visibility: hidden;
  }

  .lifecount-brand-title {
    display: block;
    color: var(--fg-strong);
    font-family: Geist, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", "Noto Sans SC", system-ui, sans-serif;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.75rem;
  }

  .lifecount-header p:last-child {
    margin: 0.65rem 0 0;
    color: var(--fg-muted);
  }

  .lifecount-toolbar,
  .lifecount-panel {
    width: 100%;
    margin-inline: auto;
  }

  .lifecount-toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .lifecount-toolbar-leading {
    display: inline-flex;
    flex: none;
    gap: 0.5rem;
  }

  .lifecount-toolbar-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 0.75rem;
    background: var(--header-control-bg);
    color: var(--header-control-fg);
    cursor: pointer;
    opacity: 1;
    transition:
      color 180ms ease,
      background 180ms ease,
      opacity 180ms ease;
  }

  .lifecount-toolbar-button svg {
    width: 1rem;
    height: 1rem;
  }

