---
import LifeCountLayout from "@/layouts/LifeCountLayout.astro";
import { lifeCountConfig } from "@/data/lifecount";
import { lifeCountMessages } from "@/i18n/lifecount";

const messages = lifeCountMessages["zh-CN"];
const iconBase = import.meta.env.BASE_URL;
const canonical = new URL(import.meta.env.BASE_URL, Astro.site).toString();
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: messages.documentTitle,
  url: canonical,
  description: messages.description,
  inLanguage: "zh-CN"
};
---

<LifeCountLayout
  title={messages.documentTitle}
  description={messages.description}
  canonical={canonical}
  lang="zh-CN"
  schema={schema}
>
  <section class="lifecount-page" data-lifecount>
    <header class="lifecount-header slide-enter">
      <div class="lifecount-header-meta">
        <p class="page-kicker">[ life count ]</p>
        <div class="lifecount-header-actions">
          <a
            class="lifecount-header-button"
            href="https://github.com/VintLin/lifecount"
            target="_blank"
            rel="noreferrer"
            data-lifecount-github
            aria-label="在 GitHub 查看 LifeCount"
            title="在 GitHub 查看 LifeCount"
          >
            <svg viewBox="0 -0.5 25 25" fill="currentColor" aria-hidden="true">
              <path d="m12.301 0h.093c2.242 0 4.34.613 6.137 1.68l-.055-.031c1.871 1.094 3.386 2.609 4.449 4.422l.031.058c1.04 1.769 1.654 3.896 1.654 6.166 0 5.406-3.483 10-8.327 11.658l-.087.026c-.063.02-.135.031-.209.031-.162 0-.312-.054-.433-.144l.002.001c-.128-.115-.208-.281-.208-.466 0-.005 0-.01 0-.014v.001q0-.048.008-1.226t.008-2.154c.007-.075.011-.161.011-.249 0-.792-.323-1.508-.844-2.025.618-.061 1.176-.163 1.718-.305l-.076.017c.573-.16 1.073-.373 1.537-.642l-.031.017c.508-.28.938-.636 1.292-1.058l.006-.007c.372-.476.663-1.036.84-1.645l.009-.035c.209-.683.329-1.468.329-2.281 0-.045 0-.091-.001-.136v.007c0-.022.001-.047.001-.072 0-1.248-.482-2.383-1.269-3.23l.003.003c.168-.44.265-.948.265-1.479 0-.649-.145-1.263-.404-1.814l.011.026c-.115-.022-.246-.035-.381-.035-.334 0-.649.078-.929.216l.012-.005c-.568.21-1.054.448-1.512.726l.038-.022-.609.384c-.922-.264-1.981-.416-3.075-.416s-2.153.152-3.157.436l.081-.02q-.256-.176-.681-.433c-.373-.214-.814-.421-1.272-.595l-.066-.022c-.293-.154-.64-.244-1.009-.244-.124 0-.246.01-.364.03l.013-.002c-.248.524-.393 1.139-.393 1.788 0 .531.097 1.04.275 1.509l-.01-.029c-.785.844-1.266 1.979-1.266 3.227 0 .025 0 .051.001.076v-.004c-.001.039-.001.084-.001.13 0 .809.12 1.591.344 2.327l-.015-.057c.189.643.476 1.202.85 1.693l-.009-.013c.354.435.782.793 1.267 1.062l.022.011c.432.252.933.465 1.46.614l.046.011c.466.125 1.024.227 1.595.284l.046.004c-.431.428-.718 1-.784 1.638l-.001.012c-.207.101-.448.183-.699.236l-.021.004c-.256.051-.549.08-.85.08-.022 0-.044 0-.066 0h.003c-.394-.008-.756-.136-1.055-.348l.006.004c-.371-.259-.671-.595-.881-.986l-.007-.015c-.198-.336-.459-.614-.768-.827l-.009-.006c-.225-.169-.49-.301-.776-.38l-.016-.004-.32-.048c-.023-.002-.05-.003-.077-.003-.14 0-.273.028-.394.077l.007-.003q-.128.072-.08.184c.039.086.087.16.145.225l-.001-.001c.061.072.13.135.205.19l.003.002.112.08c.283.148.516.354.693.603l.004.006c.191.237.359.505.494.792l.01.024.16.368c.135.402.38.738.7.981l.005.004c.3.234.662.402 1.057.478l.016.002c.33.064.714.104 1.106.112h.007c.045.002.097.002.15.002.261 0 .517-.021.767-.062l-.027.004.368-.064q0 .609.008 1.418t.008.873v.014c0 .185-.08.351-.208.466h-.001c-.119.089-.268.143-.431.143-.075 0-.147-.011-.214-.032l.005.001c-4.929-1.689-8.409-6.283-8.409-11.69 0-2.268.612-4.393 1.681-6.219l-.032.058c1.094-1.871 2.609-3.386 4.422-4.449l.058-.031c1.739-1.034 3.835-1.645 6.073-1.645h.098-.005zm-7.64 17.666q.048-.112-.112-.192-.16-.048-.208.032-.048.112.112.192.144.096.208-.032zm.497.545q.112-.08-.032-.256-.16-.144-.256-.048-.112.08.032.256.159.157.256.047zm.48.72q.144-.112 0-.304-.128-.208-.272-.096-.144.08 0 .288t.272.112zm.672.673q.128-.128-.064-.304-.192-.192-.32-.048-.144.128.064.304.192.192.32.044zm.913.4q.048-.176-.208-.256-.24-.064-.304.112t.208.24q.24.097.304-.096zm1.009.08q0-.208-.272-.176-.256 0-.256.176 0 .208.272.176.256.001.256-.175zm.929-.16q-.032-.176-.288-.144-.256.048-.224.24t.288.128.225-.224z"></path>
            </svg>
          </a>
          <button
            class="lifecount-header-button lifecount-language-button"
            type="button"
            data-lifecount-language
            aria-label="View this page in English"
            title="View this page in English"
          >
            <img
              class="lifecount-language-icon"
              data-lifecount-language-icon="en"
              src={`${iconBase}icons/english.svg`}
              alt=""
              aria-hidden="true"
            />
            <img
              class="lifecount-language-icon"
              data-lifecount-language-icon="zh"
              src={`${iconBase}icons/chinese.svg`}
              alt=""
              aria-hidden="true"
              hidden
            />
            <span class="lifecount-visually-hidden" data-lifecount-language-label>EN</span>
          </button>
          <button
            class="lifecount-header-button lifecount-theme-button"
            type="button"
            data-lifecount-theme
            aria-label="切换到浅色模式"
            title="切换到浅色模式"
          >
            <svg class="theme-sun" viewBox="0 -32 576 576" fill="currentColor" aria-hidden="true">
              <path d="M288-32c8 0 15.4 4 19.9 10.6l58.8 87.4 103.4-20.2c7.8-1.5 15.9.9 21.6 6.6s8.1 13.8 6.6 21.6L478 177.3 565.4 236.1C572 240.5 576 248 576 256s-4 15.4-10.6 19.9L478 334.7 498.2 438c1.5 7.8-.9 15.9-6.6 21.6s-13.8 8.1-21.6 6.6L366.7 446 307.9 533.4C303.4 540 296 544 288 544s-15.4-4-19.9-10.6L209.3 446 105.9 466.2c-7.8 1.5-15.9-.9-21.6-6.6s-8.1-13.8-6.6-21.6L98 334.7 10.6 275.9C4 271.4 0 264 0 256s4-15.4 10.6-19.9L98 177.3 77.8 73.9c-1.5-7.8.9-15.9 6.6-21.6s13.8-8.1 21.6-6.6l103.3 20.2 58.8-87.4 1.8-2.3C274.4-29 281-32 288-32zm-47.8 138c-5.4 8-15 12-24.5 10.2l-84-16.4 16.4 84c1.8 9.5-2.2 19.1-10.2 24.5L67 256l71 47.8c8 5.4 12 15 10.2 24.5l-16.4 84 84-16.4 3.5-.4c8.3-.4 16.3 3.6 21 10.6l47.8 71 47.8-71 2.2-2.8c5.6-6.1 14-9 22.3-7.3l84 16.4-16.4-84c-1.8-9.5 2.2-19.1 10.2-24.5l71-47.8-71-47.8c-8-5.4-12-15-10.2-24.5l16.4-84-84 16.4c-9.5 1.8-19.1-2.2-24.5-10.2l-47.8-71-47.8 71zM288 376a120 120 0 1 1 0-240 120 120 0 1 1 0 240zm0-192a72 72 0 1 0 0 144 72 72 0 1 0 0-144z"></path>
            </svg>
            <svg class="theme-moon" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
              <path d="M239.3 48.7C132.2 57.2 48 146.8 48 256c0 114.9 93.1 208 208 208 33.3 0 64.7-7.8 92.6-21.7C245.2 418.9 168 326.5 168 216c0-65.8 27.4-125.1 71.3-167.3zM0 256C0 114.6 114.6 0 256 0c19.4 0 38.4 2.2 56.7 6.3 9.9 2.2 17.3 10.5 18.5 20.5s-4 19.8-13.1 24.4C257.5 81.4 216 143.9 216 216c0 101.6 82.4 184 184 184 5 0 9.9-.2 14.8-.6 10.1-.8 19.6 4.8 23.8 14.1s2 20.1-5.3 27.1C387.3 484.8 324.8 512 256 512 114.6 512 0 397.4 0 256z"></path>
            </svg>
          </button>
        </div>
      </div>
      <h1 data-lifecount-title>人生计数</h1>
    </header>

    <div class="lifecount-toolbar slide-enter">
      <div class="lifecount-toolbar-leading">
        <button
          class="lifecount-toolbar-button"
          type="button"
          data-lifecount-settings
          aria-label="人生计数设置"
          title="人生计数设置"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </button>
        <button
          class="lifecount-toolbar-button"
          type="button"
          data-lifecount-stages
          aria-label="查看人生阶段"
          aria-expanded="false"
          title="查看人生阶段"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 5h13"></path>
            <path d="M13 12h8"></path>
            <path d="M13 19h8"></path>
            <path d="M3 10a2 2 0 0 0 2 2h3"></path>
            <path d="M3 5v12a2 2 0 0 0 2 2h3"></path>
          </svg>
        </button>
        <button
          class="lifecount-toolbar-button lifecount-annotation-toggle"
          type="button"
          data-lifecount-stage-annotations-toggle
          aria-pressed="false"
          aria-label="显示或隐藏典型人生阶段和事件"
          title="典型人生阶段和事件"
        >
          <img src={`${iconBase}icons/scroll-text.svg`} alt="" aria-hidden="true" />
          <span class="lifecount-visually-hidden" data-lifecount-stage-label>阶段</span>
        </button>
        <button
          class="lifecount-toolbar-button lifecount-annotation-toggle"
          type="button"
          data-lifecount-celebrity-annotations-toggle
          aria-pressed="false"
          aria-label="显示或隐藏名人去世时间"
          title="名人去世时间"
        >
          <img src={`${iconBase}icons/tombstone.svg`} alt="" aria-hidden="true" />
          <span class="lifecount-visually-hidden" data-lifecount-celebrity-label>名人</span>
        </button>
        <button
          class="lifecount-toolbar-button lifecount-annotation-toggle"
          type="button"
          data-lifecount-biography-toggle
          aria-pressed="false"
          aria-label="显示或隐藏名人履历"
          title="名人履历"
        >
          <img src={`${iconBase}icons/user.svg`} alt="" aria-hidden="true" />
          <span class="lifecount-visually-hidden" data-lifecount-biography-label>名人履历</span>
        </button>
        <div class="lifecount-biography-picker" data-lifecount-biography-picker hidden>
          <select data-lifecount-biography aria-label="选择名人"></select>
          <svg class="lifecount-biography-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </div>
      </div>
      <div class="lifecount-summary" aria-live="polite">
        <strong data-lifecount-age></strong>
        <span data-lifecount-summary></span>
      </div>
      <div class="lifecount-unit-switch" role="group" aria-label="选择时间单位">
        {(["day", "week", "month", "year"] as const).map((unit) => (
          <button
            type="button"
            data-lifecount-unit={unit}
            aria-pressed="false"
          >
            {unit === "day" ? "日" : unit === "week" ? "周" : unit === "month" ? "月" : "年"}
          </button>
        ))}
      </div>
    </div>

    <div class="lifecount-panel slide-enter" data-lifecount-map-wrap>
      <div class="lifecount-map-shell">
        <div class="lifecount-map-stage">
          <div class="lifecount-map" data-lifecount-map></div>
          <div class="lifecount-map-axis-x" data-lifecount-axis-x aria-hidden="true"></div>
          <div class="lifecount-map-axis-y" data-lifecount-axis-y aria-hidden="true"></div>
          <div class="lifecount-annotations" data-lifecount-annotations aria-label="关键人生节点"></div>
        </div>
      </div>
      <div class="lifecount-legend" data-lifecount-legend role="list" aria-label="图例"></div>
    </div>

    <div class="lifecount-stages-overlay" data-lifecount-stages-overlay hidden>
      <aside class="lifecount-stages-drawer" data-lifecount-stages-drawer aria-label="人生阶段">
        <div class="lifecount-stages-header">
          <h2 data-lifecount-stages-title>人生阶段</h2>
          <div class="lifecount-preset-controls">
            <div class="lifecount-select-shell lifecount-country-select">
              <select data-lifecount-country aria-label="选择国家"></select>
              <svg class="lifecount-select-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </div>
            <div class="lifecount-select-shell lifecount-preset-select">
              <select data-lifecount-preset aria-label="选择典型人生案例"></select>
              <svg class="lifecount-select-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </div>
            <div class="lifecount-select-shell lifecount-gender-select">
              <select data-lifecount-gender aria-label="选择性别，用于计算退休年龄"></select>
              <svg class="lifecount-select-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </div>
          </div>
          <button class="lifecount-toolbar-button" type="button" data-lifecount-stages-close aria-label="关闭人生阶段" title="关闭人生阶段">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
        </div>
        <div class="lifecount-stage-list" data-lifecount-stage-list></div>
      </aside>
    </div>

    <dialog class="lifecount-settings-dialog" data-lifecount-settings-dialog aria-labelledby="lifecount-settings-title">
      <form method="dialog" data-lifecount-settings-form>
        <h2 id="lifecount-settings-title" data-lifecount-settings-title>人生计数设置</h2>
        <label class="lifecount-settings-field">
          <span data-lifecount-birthday-label>出生日期</span>
          <input type="date" data-lifecount-birthday required />
        </label>
        <label class="lifecount-settings-field">
          <span data-lifecount-display-age-label>最高年龄</span>
          <input type="number" data-lifecount-display-age min="1" max="120" step="1" required />
        </label>
        <div class="lifecount-settings-actions">
          <button type="button" data-lifecount-settings-cancel>取消</button>
          <button type="submit" data-lifecount-settings-save>保存</button>
        </div>
      </form>
    </dialog>

  </section>

  <script type="application/json" id="lifecount-config" set:html={JSON.stringify(lifeCountConfig)}></script>
  <script>
    import { initLifeCount } from "@/scripts/lifecount";

    initLifeCount();
  </script>
</LifeCountLayout>

<style is:global>
  .lifecount-page {
    --life-blue: #5c6ef2;
    --life-cyan: #1ca8b8;
    --life-green: #4b9b68;
    --life-orange: #d98332;
    --life-pink: #d45b93;
    --life-purple: #936bd1;
    --life-red: #c85a5a;
    --life-sand: #b88a55;
    width: min(100%, 74rem);
    margin: 0 auto;
    padding-inline: clamp(1rem, 4vw, 4rem);
  }

  html.dark .lifecount-page {
    --life-blue: #8490ff;
    --life-cyan: #59cbd3;
    --life-green: #78c68c;
    --life-orange: #f3a25d;
    --life-pink: #ef88b8;
    --life-purple: #bd96ef;
    --life-red: #ef8484;
    --life-sand: #d7ae7d;
  }

  .lifecount-header {
    width: min(100%, 60rem);
    margin: 0 auto 2rem;
  }

  .lifecount-header-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .lifecount-header-meta .page-kicker {
    margin: 0;
  }

  .lifecount-header-actions {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 1rem;
  }

  .lifecount-header-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg-muted);
    opacity: 0.6;
    cursor: pointer;
    text-decoration: none;
    transition:
      opacity 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .lifecount-header-button:hover,
  .lifecount-header-button:focus-visible {
    color: var(--fg-strong);
    opacity: 1;
  }

  .lifecount-header-button:focus-visible {
    outline: 1px solid color-mix(in srgb, var(--fg-muted) 48%, transparent);
    outline-offset: 5px;
  }

  .lifecount-header-button svg {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
  }

  .lifecount-theme-button .theme-sun {
    display: none;
  }

  .lifecount-theme-button .theme-moon {
    display: inline-flex;
  }

  html.dark .lifecount-theme-button .theme-sun {
    display: inline-flex;
  }

  html.dark .lifecount-theme-button .theme-moon {
    display: none;
  }

  .lifecount-header h1 {
    margin: 0.6rem 0 0;
    color: var(--fg-strong);
    font-size: clamp(2rem, 5vw, 3.4rem);
    letter-spacing: -0.05em;
  }

  .lifecount-header p:last-child {
    margin: 0.65rem 0 0;
    color: var(--fg-muted);
  }

  .lifecount-toolbar,
  .lifecount-panel {
    width: min(100%, 60rem);
    margin-inline: auto;
  }

  .lifecount-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .lifecount-toolbar-leading {
    display: inline-flex;
    flex: none;
    gap: 0.25rem;
  }

  .lifecount-toolbar-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 0.45rem;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .lifecount-toolbar-button svg {
    width: 1rem;
    height: 1rem;
  }

  .lifecount-language-button {
    font-family: "DM Mono", "SFMono-Regular", Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }

  .lifecount-language-icon {
    width: 1rem;
    height: 1rem;
  }

  html.dark .lifecount-language-icon {
    filter: invert(1);
  }

  .lifecount-annotation-toggle {
    width: 2rem;
    min-width: 2rem;
    padding: 0;
  }

  .lifecount-annotation-toggle img {
    width: 1rem;
    height: 1rem;
    filter: var(--lifecount-icon-filter, none);
  }

  .lifecount-annotation-toggle[aria-pressed="true"] img {
    filter: invert(1);
  }

  .dark .lifecount-annotation-toggle[aria-pressed="true"] img {
    filter: none;
  }

  .lifecount-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .lifecount-toolbar-button:hover,
  .lifecount-toolbar-button:focus-visible,
  .lifecount-toolbar-button[aria-expanded="true"] {
    border-color: var(--border-strong);
    background: color-mix(in srgb, var(--panel) 72%, transparent);
    color: var(--fg-strong);
  }

  .lifecount-annotation-toggle[aria-pressed="true"] {
    border-color: var(--fg-strong);
    background: var(--fg-strong);
    color: var(--bg);
  }

  .lifecount-toolbar-button:disabled {
    cursor: not-allowed;
    opacity: 0.38;
  }

  .lifecount-stages-header select:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .lifecount-biography-picker {
    position: relative;
    width: 9.5rem;
    min-width: 0;
  }

  .lifecount-biography-picker select {
    appearance: none;
    width: 100%;
    height: 2rem;
